<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_matrix_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_input"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/widget_input_background"
        android:contentDescription="打开首页输入待办"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:text="＋  输入新的待办事项"
        android:textColor="#5F6D7B"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_q0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_q0"
            android:contentDescription="打开立即做象限"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView android:id="@+id/widget_count0" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="0" android:textColor="#293847" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#293847" android:textSize="13sp" />
            <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lxgw_wenkai_lite_regular" android:gravity="center" android:text="立即做" android:textColor="#A65F69" android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_q1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_q1"
            android:contentDescription="打开安排做象限"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView android:id="@+id/widget_count1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="0" android:textColor="#293847" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#293847" android:textSize="13sp" />
            <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lxgw_wenkai_lite_regular" android:gravity="center" android:text="安排做" android:textColor="#4B9CA0" android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_q2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_q2"
            android:contentDescription="打开委托做象限"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView android:id="@+id/widget_count2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="0" android:textColor="#293847" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#293847" android:textSize="13sp" />
            <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lxgw_wenkai_lite_regular" android:gravity="center" android:text="委托做" android:textColor="#5D83B0" android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_q3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_q3"
            android:contentDescription="打开尽量不做象限"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView android:id="@+id/widget_count3" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="0" android:textColor="#293847" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#293847" android:textSize="13sp" />
            <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lxgw_wenkai_lite_regular" android:gravity="center" android:text="尽量不做" android:textColor="#777A80" android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
